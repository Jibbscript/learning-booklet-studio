{
  "name": "learning-booklet-studio",
  "version": "0.1.3",
  "description": "A Codex skill and local MCP Apps workflow for building verified interactive learning booklets.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/widget",
    "packages/mcp-server"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/widget && node scripts/build-mcp.mjs",
    "build:widget": "npm run build --workspace packages/widget",
    "build:mcp": "node scripts/build-mcp.mjs",
    "check": "node scripts/check-repo.mjs",
    "pretest": "npm run build",
    "test": "npm run test:unit && npm run test:bdd && npm run test:release-verifier && npm run test:mcp && npm run test:widget && npm run test:standalone",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:bdd": "cucumber-js --no-strict --import tests/step-definitions/**/*.mjs tests/features/**/*.feature",
    "test:release-verifier": "node --test tests/integration/release-verifier.test.mjs tests/integration/automated-release-evidence.test.mjs tests/integration/installed-candidate.test.mjs tests/integration/installed-package-smoke.test.mjs",
    "test:mcp": "node --test tests/integration/mcp-server.test.mjs tests/integration/mcp-store-acceptance.test.mjs",
    "test:widget": "node --test tests/integration/widget-contract.test.mjs && npm run test:sites --workspace packages/widget",
    "pretest:e2e": "npm run build:widget",
    "test:e2e": "node tests/e2e/widget.e2e.mjs",
    "test:release": "node scripts/verify-oss-release.mjs",
    "test:release:partial": "node scripts/verify-oss-release.mjs --allow-partial",
    "verify:installed-candidate": "node scripts/check-installed-candidate.mjs",
    "package:release": "npm run build && node scripts/verify-oss-release.mjs",
    "validate": "npm run validate:plugin && npm run validate:skill",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "validate:skill": "node scripts/validate-skill.mjs",
    "test:standalone": "node --test tests/integration/standalone-skill.test.mjs"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.57",
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.0",
    "ajv": "8.20.0",
    "axe-core": "4.12.1",
    "esbuild": "0.28.1",
    "playwright": "1.62.0"
  }
}
