{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-booklet.studio/contracts/gate-result.schema.json",
  "title": "Hard-gate evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phaseId",
    "gateId",
    "hard",
    "status",
    "reasons",
    "evidenceIds",
    "artifactHashes",
    "stale",
    "staleReason",
    "evaluatedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "phaseId": {
      "enum": ["I0", "P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P10"]
    },
    "gateId": { "type": "string", "minLength": 1 },
    "hard": { "const": true },
    "status": { "enum": ["pass", "fail"] },
    "reasons": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "artifactHashes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
      "uniqueItems": true
    },
    "stale": { "type": "boolean" },
    "staleReason": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
    "evaluatedAt": { "type": "string", "format": "date-time" }
  }
}
