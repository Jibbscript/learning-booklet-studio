{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-booklet.studio/contracts/intent-field.schema.json",
  "title": "Intent field",
  "type": "object",
  "additionalProperties": false,
  "required": ["value", "origin", "locked", "confidence", "updatedAt", "evidenceRefs"],
  "properties": {
    "value": {},
    "origin": {
      "enum": ["user", "researched", "inferred", "defaulted"]
    },
    "locked": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
