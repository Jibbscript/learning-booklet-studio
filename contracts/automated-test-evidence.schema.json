{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learning-booklet.studio/contracts/automated-test-evidence.schema.json",
  "title": "Automated release-test evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "subjectSha256",
    "observedAt",
    "environment",
    "checks",
    "commands",
    "attachments"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["pass", "fail", "partial", "not_run", "not_applicable"] },
    "subjectSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observedAt": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "node", "npm"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "npm": { "type": "string", "minLength": 1 },
        "playwright": { "type": "string", "minLength": 1 },
        "browserEngine": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "executed", "summary"],
        "properties": {
          "id": {
            "enum": [
              "repository",
              "schema-and-unit",
              "bdd",
              "mcp",
              "widget",
              "browser-runtime",
              "accessibility",
              "offline-network",
              "secret-and-license"
            ]
          },
          "status": { "enum": ["pass", "fail", "partial", "not_run", "not_applicable"] },
          "executed": { "type": "boolean" },
          "summary": { "type": "string", "minLength": 1 },
          "resultRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "pendingExternalScenarios": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exitCode", "status", "toolVersion", "resultPath", "resultSha256"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "const": 0 },
          "status": { "const": "pass" },
          "toolVersion": { "type": "string", "minLength": 1 },
          "resultPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "resultSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "kind": { "enum": ["log", "test-result", "screenshot", "recording"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } } },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": { "const": "pass" },
                "executed": { "const": true },
                "resultRefs": { "minItems": 1 }
              },
              "required": ["resultRefs"]
            }
          }
        }
      }
    }
  ]
}
